/* styles/index.css */


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Poppins,sans-serif;
  }
  
  body{
    min-height:100%;
    width:100%;
   
    background:linear-gradient(135deg,#0b132b,#1c2541,#3a506b);
    color:white;
    position:relative;
  }
  
  /* SMOOTH BACKGROUND GLOW */
  
  body::before,
  body::after{
    content:'';
    position:absolute;
    width:400px;
    height:400px;
    border-radius:50%;
    filter:blur(120px);
    opacity:.35;
    z-index:-1;
  }
  
  body::before{
    background:#5eead4;
    top:-100px;
    left:-100px;
  }
  
  body::after{
    background:#7c83fd;
    bottom:-120px;
    right:-100px;
  }
  
  /* HOME */
  
  .home{
    width:100%;
    min-height:90vh;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:50px 8%;
    gap:40px;
  }
  
  .content{
    flex:1;
    animation:fadeLeft 1s ease;
  }
  
  .content h3{
    color:#5eead4;
    font-size:26px;
    margin-bottom:10px;
    letter-spacing:1px;
  }
  
  .content h1{
    font-size:72px;
    margin-bottom:10px;
    line-height:1.1;
  }
  
  .content h2{
    font-size:34px;
    color:#a5b4fc;
    margin-bottom:22px;
  }
  
  .content p{
    max-width:550px;
    line-height:1.9;
    color:#d1d5db;
    margin-bottom:35px;
  }
  
  /* BUTTONS */
  
  .buttons{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
  }
  
  .buttons a{
    text-decoration:none;
    color:white;
    padding:14px 32px;
    border-radius:40px;
    background:rgba(255,255,255,0.08);
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,0.15);
    transition:.4s;
    font-weight:500;
    box-shadow:0 8px 25px rgba(0,0,0,.2);
  }
  
  .buttons a:hover{
    transform:translateY(-5px);
    background:rgba(255,255,255,0.15);
    box-shadow:0 10px 25px rgba(94,234,212,.25);
  }
  
  /* IMAGE */
  
  .image{
    flex:1;
    display:flex;
    justify-content:center;
    position:relative;
    animation:fadeRight 1s ease;
  }
  
  .image::before{
    content:'';
    position:absolute;
    width:340px;
    height:340px;
    background:rgba(255,255,255,0.08);
    border-radius:50%;
    backdrop-filter:blur(20px);
    border:1px solid rgba(255,255,255,0.1);
    box-shadow:0 0 40px rgba(255,255,255,.08);
  }
  
  .image img{
    width:380px;
    z-index:1;
    animation:float 4s ease-in-out infinite;
    filter:drop-shadow(0 10px 25px rgba(0,0,0,.35));
  }
  
  /* ANIMATIONS */
  
  @keyframes float{
    0%,100%{
      transform:translateY(0);
    }
    50%{
      transform:translateY(-15px);
    }
  }
  
  @keyframes fadeLeft{
    from{
      opacity:0;
      transform:translateX(-50px);
    }
    to{
      opacity:1;
      transform:translateX(0);
    }
  }
  
  @keyframes fadeRight{
    from{
      opacity:0;
      transform:translateX(50px);
    }
    to{
      opacity:1;
      transform:translateX(0);
    }
  }
  
  /* MOBILE */
  
  @media(max-width:900px){

 
    .content{
      width:100%;
    }
  
    .content h1{
      font-size:48px;
      word-break:break-word;
    }
  
    .content h2{
      font-size:26px;
    }
  
    .content p{
      max-width:100%;
    }
  
    .buttons{
      justify-content:center;
    }
  
    .image{
      width:100%;
    }
  
    .image img{
      width:270px;
      max-width:100%;
    }
  
    .image::before{
      width:240px;
      height:240px;
    }
  
    body::before,
    body::after{
      width:220px;
      height:220px;
    }
  
  }